{
  "name": "raidru",
  "private": true,
  "version": "3.0.0-alpha.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm --workspace @raidru/web run dev",
    "build": "npm --workspace @raidru/web run build",
    "typecheck": "npm --workspace @raidru/web run typecheck",
    "test": "node scripts/validate.mjs",
    "preview": "npm --workspace @raidru/web run preview"
  }
}
